# ============ AGENT EXPERTS - ENV ============
# DeepSeek AI
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# Supabase / PostgreSQL database connection string
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# Security (change these!)
SECRET_KEY=CHANGE_ME_to_a_long_random_secret_key_32_chars
# Master password to access the agent control/dashboard
OWNER_PASSWORD=change123
# Access token for the chatbot endpoint
AGENT_TOKEN=agent-secret

# Environment: development / production
APP_ENV=development

# Agent wallet currency (base) - USD or PKR
BASE_CURRENCY=USD
# Agent's allocated balance (limit) - agent only sees/runs on this
INITIAL_BALANCE=1000

# Stop-loss protection (in % of current balance)
DAILY_LOSS_LIMIT_PCT=10
TOTAL_LOSS_LIMIT_PCT=20
MAX_TRADE_SIZE_PCT=10
MIN_BALANCE_THRESHOLD=200

# Payoneer (future auto-detect) - optional now
PAYONEER_API_KEY=
PAYONEER_ACCOUNT_ID=
